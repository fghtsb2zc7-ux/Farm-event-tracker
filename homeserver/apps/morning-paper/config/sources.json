    {"name": "404 Media",       "from": ["@404media.co"]},
    {"name": "Substack",        "from": ["@substack.com"]}
  ],

  "feeds": [
    {"name": "404 Media", "url": "${FEED_404MEDIA}"},
    {"name": "Reuters",   "url": "https://news.google.com/rss/search?q=site:reuters.com+when:1d&hl=en-CA&gl=CA&ceid=CA:en"},
    {"name": "Financial Times", "url": "https://www.ft.com/rss/home"},
    {"name": "The Economist",   "url": "https://www.economist.com/latest/rss.xml"}
  ]
