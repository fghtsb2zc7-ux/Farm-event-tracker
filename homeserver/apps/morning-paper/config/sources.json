{
  "_comment": "Morning Paper sources. Edit freely; changes apply at the next run.",
  "paper_title": "The Morning Paper",
  "paper_tagline": "All the Reads Worth Your Time",
  "articles_per_edition": 4,
  "min_words": 250,
  "max_item_age_hours": 36,
